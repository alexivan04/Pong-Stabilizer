	(text "CONTROL - TEENSY 4.1"
		(exclude_from_sim no)
		(at 241.3 27.94 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "05172cdb-a14a-4484-b5e1-caea2eaae790")
	)
	(text "Own 5V step-down module, always on"
		(exclude_from_sim no)
		(at 152.4 171.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0d225692-9770-4f17-9a0d-72cf53c4ec37")
	)
	(text "Supplied only through USB (VUSB)\nfrom the Raspberry Pi 5.\n200 Hz control loop, 3.3V outputs.\nEncoder pins defined in the firmware\n(CS 0, CAL 12, A/B 10/11) are unused."
		(exclude_from_sim no)
		(at 241.3 118.11 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "23d2ece8-80a1-499b-b6e4-8d80585541a3")
	)
	(text "MOTOR DRIVE"
		(exclude_from_sim no)
		(at 312.42 27.94 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "23e486ed-2f01-45c3-99e4-459f7b6af329")
	)
	(text "230V AC mains: L switched by SW1 (master switch).\nPS1: 48V DC for the four DM556 power stages and PS2.\nPS2: EMG122 step-down (10-90V in), 5V for the Raspberry Pi 5, max. 6 A.\nSW1: 230V AC, 300 A.  One common ground: PS2 is non-isolated."
		(exclude_from_sim no)
		(at 17.78 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2cadf9f5-013f-4a75-8869-da6d5f71aade")
	)
	(text "Pin numbers: Raspberry Pi 5 = physical pins of the 40-pin header; Teensy 4.1 = digital pin numbers used in the firmware.\nNets with the same label are connected (UART_TX, UART_RX, TEENSY_PROG, USB_D+/-, VUSB, STEP_Mx, DIR_Mx).\nUART_TX: Pi GPIO14/TXD (pin 8) -> Teensy RX1 (pin 0).   UART_RX: Teensy TX1 (pin 1) -> Pi GPIO15/RXD (pin 10).\nTEENSY_PROG: Pi GPIO23 (pin 16) -> Teensy PROGRAM, puts the Teensy in bootloader mode for flashing.\nMotor channels: M0 rear right (STEP 8, DIR 7), M1 front right (4, 3), M2 front left (6, 5), M3 rear left (10, 9).\nParts: PS2 EMG122 step-down (10-90V in, 6 A, non-isolated); camera: Raspberry Pi Global Shutter Camera with fisheye lens;\nmotors: Robofun NEMA 17 (1.5 A, 1.8 deg); DM556 set to 2.7 A RMS; SW1: 230V AC, 300 A; LED lighting: own 5V step-down, always on."
		(exclude_from_sim no)
		(at 17.78 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7c41785a-dc7a-4781-9d6f-2ca79e42119e")
	)
	(text "UART: /dev/ttyAMA0, 115200 baud, 3.3V.\nSupplied through pins 2/4 (no USB-C PD):\nUSB ports limited to 600 mA."
		(exclude_from_sim no)
		(at 129.54 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "81fc73f8-33ae-4279-b34e-170517dcfdc0")
	)
	(text "Common-cathode inputs: PUL+/DIR+ from the 3.3V Teensy outputs\n(5V nominal); PUL-, DIR- and ENA- to the driver GND terminal;\nENA+ not connected (always enabled). 1/16 = 3200 pulses/rev.\nDM556 current: 2.7 A RMS.  Motors: Robofun NEMA 17, 1.5 A, 1.8 deg."
		(exclude_from_sim no)
		(at 312.42 231.14 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "93074eaa-55ba-4292-818d-a293e645c729")
	)
	(text "POWER SUPPLY"
		(exclude_from_sim no)
		(at 17.78 27.94 0)
		(effects
			(font
				(size 2 2)
				(thickness 0.4)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "a09683cd-c500-434f-ba6e-2321fbc287d0")
	)
	(text "CSI ribbon cable to the\nCAM/DISP port of the Pi 5\n640x480 at 60 fps"
